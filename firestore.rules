rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function hasAppCheck() {
      return request.app != null;
    }

    function canAccess() {
      return isVerified() && hasAppCheck();
    }

    function isPropertyOwner(propertyId) {
      return isVerified() &&
        get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isValidRole(role) {
      return role in ['owner', 'caretaker', 'property_manager', 'tenant'];
    }

    function isManagerRole(role) {
      return role in ['owner', 'caretaker', 'property_manager'];
    }

    function isAssignedTenant() {
      return isVerified() &&
        userDoc().role == 'tenant' &&
        userDoc().linkedPropertyId is string &&
        userDoc().tenantRecordId is string;
    }

    function isPendingTenantAssignment(ownerId) {
      return isVerified() && resource.data.linkedOwnerId == ownerId &&
        (!('tenantRecordId' in resource.data) || resource.data.tenantRecordId == null);
    }

    function hasNoTenantAssignment() {
      return !('tenantRecordId' in userDoc()) || userDoc().tenantRecordId == null;
    }

    function canSelfJoinProperty(propertyId) {
      return hasNoTenantAssignment() && (
        !('linkedPropertyId' in userDoc()) ||
        userDoc().linkedPropertyId == null ||
        userDoc().linkedPropertyId == propertyId
      );
    }

    function vacantUnitForProperty(unitId, propertyId) {
      let unit = get(/databases/$(database)/documents/units/$(unitId)).data;
      return unit.propertyId == propertyId && unit.status == 'vacant';
    }

    function profileOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'phone', 'photoUrl', 'countryCode']) &&
        (
          !('countryCode' in request.resource.data) ||
          request.resource.data.countryCode is string
        );
    }

    function ownerInviteCodeUpdate() {
      return isManagerRole(resource.data.role) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerInviteCode']);
    }

    function tenantOwnerLinkUpdate() {
      return request.resource.data.role == 'tenant' &&
        request.resource.data.linkedOwnerId is string &&
        hasNoTenantAssignment() &&
        (
          (
            resource.data.role != 'tenant' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['linkedOwnerId', 'role'])
          ) ||
          (
            resource.data.role == 'tenant' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['linkedOwnerId'])
          )
        );
    }

    function tenantPropertyLinkUpdate() {
      return request.resource.data.role == 'tenant' &&
        request.resource.data.linkedPropertyId is string &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['linkedOwnerId', 'linkedPropertyId', 'role']) ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['linkedPropertyId', 'role'])
        );
    }

    function tenantRecordLinkUpdate() {
      return resource.data.role == 'tenant' &&
        resource.data.linkedPropertyId is string &&
        request.resource.data.tenantRecordId is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tenantRecordId']);
    }

    function tenantPropertyJoinUpdate() {
      return request.resource.data.role == 'tenant' &&
        request.resource.data.linkedPropertyId is string &&
        request.resource.data.tenantRecordId is string &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['linkedOwnerId', 'linkedPropertyId', 'tenantRecordId', 'role']) ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['linkedPropertyId', 'tenantRecordId', 'role']) ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['linkedOwnerId', 'linkedPropertyId', 'tenantRecordId']) ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['linkedPropertyId', 'tenantRecordId'])
        );
    }

    match /inviteCodes/{codeId} {
      allow get: if canAccess() && (
        resource.data.active == true ||
        resource.data.ownerId == request.auth.uid
      );
      allow create: if canAccess() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.active == true;
      allow delete: if canAccess() && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if (
        isSignedIn() && request.auth.uid == userId
      ) || (
        canAccess() && resource.data.linkedOwnerId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        hasAppCheck() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'role', 'createdAt', 'countryCode']) &&
        isValidRole(request.resource.data.role) &&
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.email is string &&
        (
          !('countryCode' in request.resource.data) ||
          request.resource.data.countryCode is string
        );
      allow update: if canAccess() && (
        (
          request.auth.uid == userId && (
            profileOnlyUpdate() ||
            ownerInviteCodeUpdate() ||
            tenantOwnerLinkUpdate() ||
            tenantPropertyLinkUpdate() ||
            tenantPropertyJoinUpdate() ||
            tenantRecordLinkUpdate()
          )
        ) ||
        (
          isPendingTenantAssignment(request.auth.uid) &&
          request.resource.data.tenantRecordId is string &&
          request.resource.data.linkedPropertyId is string &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['tenantRecordId', 'linkedPropertyId'])
        )
      );
    }

    match /properties/{propertyId} {
      allow read: if canAccess() && (
        resource.data.ownerId == request.auth.uid ||
        (
          isAssignedTenant() &&
          userDoc().linkedPropertyId == propertyId
        )
      );
      allow create: if canAccess() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if canAccess() && resource.data.ownerId == request.auth.uid;
    }

    match /units/{unitId} {
      allow read: if canAccess() && (
        isPropertyOwner(resource.data.propertyId) ||
        resource.data.status == 'vacant'
      );
      allow create: if canAccess() && isPropertyOwner(request.resource.data.propertyId);
      allow update: if canAccess() && (
        isPropertyOwner(resource.data.propertyId) ||
        (
          resource.data.status == 'vacant' &&
          request.resource.data.status == 'occupied' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          (
            userDoc().linkedPropertyId == resource.data.propertyId ||
            canSelfJoinProperty(resource.data.propertyId)
          )
        )
      );
      allow delete: if canAccess() && isPropertyOwner(resource.data.propertyId);
    }

    match /tenants/{tenantId} {
      allow read: if canAccess() && (
        isPropertyOwner(resource.data.propertyId) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if canAccess() && (
        isPropertyOwner(request.resource.data.propertyId) ||
        (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.unitId is string &&
          canSelfJoinProperty(request.resource.data.propertyId) &&
          vacantUnitForProperty(
            request.resource.data.unitId,
            request.resource.data.propertyId
          )
        )
      );
      allow update, delete: if canAccess() && isPropertyOwner(resource.data.propertyId);
    }

    match /payments/{paymentId} {
      allow read: if canAccess() && (
        isPropertyOwner(resource.data.propertyId) ||
        (
          isAssignedTenant() &&
          resource.data.tenantId == userDoc().tenantRecordId
        )
      );
      allow create: if canAccess() && (
        isPropertyOwner(request.resource.data.propertyId) ||
        (
          isAssignedTenant() &&
          request.resource.data.propertyId == userDoc().linkedPropertyId &&
          request.resource.data.tenantId == userDoc().tenantRecordId &&
          request.resource.data.status == 'pending_verification' &&
          request.resource.data.reportedByTenant == true &&
          request.resource.data.recordedBy == request.auth.uid
        )
      );
      allow update: if canAccess() && isPropertyOwner(resource.data.propertyId);
      allow delete: if canAccess() && isPropertyOwner(resource.data.propertyId);
    }

    match /expenses/{expenseId} {
      allow read: if canAccess() && isPropertyOwner(resource.data.propertyId);
      allow create: if canAccess() && isPropertyOwner(request.resource.data.propertyId);
      allow update, delete: if canAccess() && isPropertyOwner(resource.data.propertyId);
    }

    match /maintenanceRequests/{requestId} {
      allow read: if canAccess() && (
        isPropertyOwner(resource.data.propertyId) ||
        (
          isAssignedTenant() &&
          resource.data.tenantId == userDoc().tenantRecordId
        )
      );
      allow create: if canAccess() && (
        isPropertyOwner(request.resource.data.propertyId) ||
        (
          isAssignedTenant() &&
          request.resource.data.propertyId == userDoc().linkedPropertyId &&
          request.resource.data.tenantId == userDoc().tenantRecordId
        )
      );
      allow update, delete: if canAccess() && isPropertyOwner(resource.data.propertyId);
    }

    match /sharedBills/{billId} {
      allow read: if canAccess() && isPropertyOwner(resource.data.propertyId);
      allow create: if canAccess() && isPropertyOwner(request.resource.data.propertyId);
      allow update, delete: if canAccess() && isPropertyOwner(resource.data.propertyId);
    }

    match /rentReminders/{reminderId} {
      allow read: if canAccess() && (
        isPropertyOwner(resource.data.propertyId) ||
        (
          isAssignedTenant() &&
          resource.data.tenantId == userDoc().tenantRecordId
        )
      );
      allow create: if canAccess() &&
        isPropertyOwner(request.resource.data.propertyId) &&
        request.resource.data.sentBy == request.auth.uid &&
        request.resource.data.read == false &&
        request.resource.data.tenantId is string &&
        request.resource.data.message is string;
      allow update: if canAccess() && (
        (
          isAssignedTenant() &&
          resource.data.tenantId == userDoc().tenantRecordId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
          request.resource.data.read == true
        ) ||
        isPropertyOwner(resource.data.propertyId)
      );
      allow delete: if canAccess() && isPropertyOwner(resource.data.propertyId);
    }
  }
}
